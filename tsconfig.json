{
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "./src",
    "lib": ["es2019", "esnext.asynciterable", "esnext.disposable"],
    "target": "es2019",
    "module": "commonjs",
    "types": ["node", "jest"],
    "declaration": true,
    "strict": false,
    "allowJs": true,
    "moduleResolution": "bundler",
    "sourceMap": true,
    "esModuleInterop": true
  },
  "include": ["./src/**/*"],
  "exclude": ["./**/*.d.ts"]
}
